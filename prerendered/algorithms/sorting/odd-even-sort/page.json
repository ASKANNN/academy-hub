\"9.5\" stroke=\"currentColor\" stroke-width=\"1.8\"></circle><circle cx=\"12\" cy=\"8\" r=\"1.6\" fill=\"currentColor\"></circle><path d=\"M6.5 10.5c3.6 1.1 7.4 1.1 11 0M12 10.5V18M12 14l-2.6 4M12 14l2.6 4\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button><button type=\"button\" id=\"a11y-dock-tab\" class=\"a11y-dock__tab\" aria-expanded=\"true\" aria-label=\"Показать/скрыть кнопку доступности\"><svg width=\"10\" height=\"14\" viewBox=\"0 0 10 14\" fill=\"none\" aria-hidden=\"true\"><path d=\"M8 1 2 7l6 6\" stroke=\"currentColor\" stroke-width=\"1.8\" stroke-linecap=\"round\" stroke-linejoin=\"round\"></path></svg></button></div><div id=\"a11y-panel\" class=\"a11y-widget__panel\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"a11y-panel-title\" aria-hidden=\"true\"><div class=\"a11y-widget__header\"><h2 id=\"a11y-panel-title\" class=\"a11y-widget__title\">Доступность</h2><button type=\"button\" id=\"a11y-close\" class=\"a11y-widget__close\" aria-label=\"Закрыть панель доступности\">×</button></div><div class=\"a11y-widget__body\"><fieldset class=\"a11y-widget__group\"><legend class=\"a11y-widget__group-label\">Размер текста</legend><div class=\"a11y-widget__segmented\" role=\"radiogroup\" aria-label=\"Размер текста\"><button type=\"button\" role=\"radio\" aria-checked=\"true\" tabindex=\"0\" class=\"a11y-widget__segment\">Обычный</button><button type=\"button\" role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" class=\"a11y-widget__segment\">Крупный</button><button type=\"button\" role=\"radio\" aria-checked=\"false\" tabindex=\"-1\" class=\"a11y-widget__segment\">Очень крупный</button></div></fieldset><fieldset class=\"a11y-widget__group\"><legend class=\"a11y-widget__group-label\">Контрастность</legend><div class=\"a11y-widget__segmented\" role=\"radiogroup\" aria-label=\"Контрастность\"><button type=\"button\" role=\"radio\" aria-checked=\"true\" tabindex=\"0\" class=\"a11y-widget__s